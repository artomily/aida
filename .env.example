# sectors.app v2 API key — https://sectors.app/api. Only jobs under ingest/ use it; page loads never do.
SECTORS_API_KEY=

# Neon Postgres — `neon link --project-id <id> --branch production -y` writes these for you.
# Empty locally means the pipeline stores JSON under .data/ instead (required on Vercel).
DATABASE_URL=

# Password for /admin (backfill, re-runs, data checks). Empty = admin area disabled.
ADMIN_PASSWORD=

# Signs user sessions for /login and /register (`openssl rand -base64 32`). Required in production;
# `next dev` falls back to a fixed dev-only secret. Changing it signs every user out.
AUTH_SECRET=

# Vercel Cron sends `Authorization: Bearer $CRON_SECRET` to /api/cron/*; anything else gets 401.
CRON_SECRET=

# Optional: Morning Brief via Claude. Without it (or with BRIEF_LLM=0) a deterministic template is used.
ANTHROPIC_API_KEY=
# BRIEF_LLM=0

# Hard cap on upstream calls per rolling hour (the backfill raises it to its own estimate).
SECTORS_MAX_CALLS_PER_HOUR=400
# Hard cap per WIB day, summed from job_runs so it holds on Vercel too (the backfill is exempt).
SECTORS_MAX_CALLS_PER_DAY=150
# Gap between upstream requests; sectors.app rate-limits per minute.
SECTORS_PACE_MS=1500

# Largest emiten per sector that make up the sector return proxy, and backfill depth in years.
AIDA_TOP_N=5
BACKFILL_YEARS=3

# Point ingest at the local mock (npm run mock:sectors) and keep its data apart:
# SECTORS_API_BASE=http://127.0.0.1:4010/v2
# AIDA_DATA_DIR=.data-mock
