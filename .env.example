# sectors.app v2 API key (Insider plan) — https://sectors.app/api
# Copy to .env.local and fill in. Without it the SGX × IDX view runs on labelled sample data.
SECTORS_API_KEY=

# How many of the largest IDX emiten to scan for SGX shareholders (1 report credit each, cached 24h).
SECTORS_LINK_SCAN=25

# Hard cap on upstream sectors.app calls per rolling hour; past it the app serves sample data.
# Counts calls, not credits (a 3-section company report is 1 call but 3 credits).
SECTORS_MAX_CALLS_PER_HOUR=400
